[{"s":26,"a":184,"t":"وَاتَّقُوا الَّذِي خَلَقَكُمْ وَالْجِبِلَّةَ الْأَوَّلِينَ"},{"s":26,"a":185,"t":"قَالُوا إِنَّمَا أَنْتَ مِنَ الْمُسَحَّرِينَ"},{"s":26,"a":186,"t":"وَمَا أَنْتَ إِلَّا بَشَرٌ مِثْلُنَا وَإِنْ نَظُنُّكَ لَمِنَ الْكَاذِبِينَ"},{"s":26,"a":187,"t":"فَأَسْقِطْ عَلَيْنَا كِسَفًا مِنَ السَّمَاءِ إِنْ كُنْتَ مِنَ الصَّادِقِينَ"},{"s":26,"a":188,"t":"قَالَ رَبِّي أَعْلَمُ بِمَا تَعْمَلُونَ"},{"s":26,"a":189,"t":"فَكَذَّبُوهُ فَأَخَذَهُمْ عَذَابُ يَوْمِ الظُّلَّةِ ۚ إِنَّهُ كَانَ عَذَابَ يَوْمٍ عَظِيمٍ"},{"s":26,"a":190,"t":"إِنَّ فِي ذَٰلِكَ لَآيَةً ۖ وَمَا كَانَ أَكْثَرُهُمْ مُؤْمِنِينَ"},{"s":26,"a":191,"t":"وَإِنَّ رَبَّكَ لَهُوَ الْعَزِيزُ الرَّحِيمُ"},{"s":26,"a":192,"t":"وَإِنَّهُ لَتَنْزِيلُ رَبِّ الْعَالَمِينَ"},{"s":26,"a":193,"t":"نَزَلَ بِهِ الرُّوحُ الْأَمِينُ"},{"s":26,"a":194,"t":"عَلَىٰ قَلْبِكَ لِتَكُونَ مِنَ الْمُنْذِرِينَ"},{"s":26,"a":195,"t":"بِلِسَانٍ عَرَبِيٍّ مُبِينٍ"},{"s":26,"a":196,"t":"وَإِنَّهُ لَفِي زُبُرِ الْأَوَّلِينَ"},{"s":26,"a":197,"t":"أَوَلَمْ يَكُنْ لَهُمْ آيَةً أَنْ يَعْلَمَهُ عُلَمَاءُ بَنِي إِسْرَائِيلَ"},{"s":26,"a":198,"t":"وَلَوْ نَزَّلْنَاهُ عَلَىٰ بَعْضِ الْأَعْجَمِينَ"},{"s":26,"a":199,"t":"فَقَرَأَهُ عَلَيْهِمْ مَا كَانُوا بِهِ مُؤْمِنِينَ"},{"s":26,"a":200,"t":"كَذَٰلِكَ سَلَكْنَاهُ فِي قُلُوبِ الْمُجْرِمِينَ"},{"s":26,"a":201,"t":"لَا يُؤْمِنُونَ بِهِ حَتَّىٰ يَرَوُا الْعَذَابَ الْأَلِيمَ"},{"s":26,"a":202,"t":"فَيَأْتِيَهُمْ بَغْتَةً وَهُمْ لَا يَشْعُرُونَ"},{"s":26,"a":203,"t":"فَيَقُولُوا هَلْ نَحْنُ مُنْظَرُونَ"},{"s":26,"a":204,"t":"أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ"},{"s":26,"a":205,"t":"أَفَرَأَيْتَ إِنْ مَتَّعْنَاهُمْ سِنِينَ"},{"s":26,"a":206,"t":"ثُمَّ جَاءَهُمْ مَا كَانُوا يُوعَدُونَ"}]