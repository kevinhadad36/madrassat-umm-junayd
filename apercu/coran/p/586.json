[{"s":81,"a":1,"t":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ إِذَا الشَّمْسُ كُوِّرَتْ"},{"s":81,"a":2,"t":"وَإِذَا النُّجُومُ انْكَدَرَتْ"},{"s":81,"a":3,"t":"وَإِذَا الْجِبَالُ سُيِّرَتْ"},{"s":81,"a":4,"t":"وَإِذَا الْعِشَارُ عُطِّلَتْ"},{"s":81,"a":5,"t":"وَإِذَا الْوُحُوشُ حُشِرَتْ"},{"s":81,"a":6,"t":"وَإِذَا الْبِحَارُ سُجِّرَتْ"},{"s":81,"a":7,"t":"وَإِذَا النُّفُوسُ زُوِّجَتْ"},{"s":81,"a":8,"t":"وَإِذَا الْمَوْءُودَةُ سُئِلَتْ"},{"s":81,"a":9,"t":"بِأَيِّ ذَنْبٍ قُتِلَتْ"},{"s":81,"a":10,"t":"وَإِذَا الصُّحُفُ نُشِرَتْ"},{"s":81,"a":11,"t":"وَإِذَا السَّمَاءُ كُشِطَتْ"},{"s":81,"a":12,"t":"وَإِذَا الْجَحِيمُ سُعِّرَتْ"},{"s":81,"a":13,"t":"وَإِذَا الْجَنَّةُ أُزْلِفَتْ"},{"s":81,"a":14,"t":"عَلِمَتْ نَفْسٌ مَا أَحْضَرَتْ"},{"s":81,"a":15,"t":"فَلَا أُقْسِمُ بِالْخُنَّسِ"},{"s":81,"a":16,"t":"الْجَوَارِ الْكُنَّسِ"},{"s":81,"a":17,"t":"وَاللَّيْلِ إِذَا عَسْعَسَ"},{"s":81,"a":18,"t":"وَالصُّبْحِ إِذَا تَنَفَّسَ"},{"s":81,"a":19,"t":"إِنَّهُ لَقَوْلُ رَسُولٍ كَرِيمٍ"},{"s":81,"a":20,"t":"ذِي قُوَّةٍ عِنْدَ ذِي الْعَرْشِ مَكِينٍ"},{"s":81,"a":21,"t":"مُطَاعٍ ثَمَّ أَمِينٍ"},{"s":81,"a":22,"t":"وَمَا صَاحِبُكُمْ بِمَجْنُونٍ"},{"s":81,"a":23,"t":"وَلَقَدْ رَآهُ بِالْأُفُقِ الْمُبِينِ"},{"s":81,"a":24,"t":"وَمَا هُوَ عَلَى الْغَيْبِ بِضَنِينٍ"},{"s":81,"a":25,"t":"وَمَا هُوَ بِقَوْلِ شَيْطَانٍ رَجِيمٍ"},{"s":81,"a":26,"t":"فَأَيْنَ تَذْهَبُونَ"},{"s":81,"a":27,"t":"إِنْ هُوَ إِلَّا ذِكْرٌ لِلْعَالَمِينَ"},{"s":81,"a":28,"t":"لِمَنْ شَاءَ مِنْكُمْ أَنْ يَسْتَقِيمَ"},{"s":81,"a":29,"t":"وَمَا تَشَاءُونَ إِلَّا أَنْ يَشَاءَ اللَّهُ رَبُّ الْعَالَمِينَ"}]