[{"s":82,"a":1,"t":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ إِذَا السَّمَاءُ انْفَطَرَتْ"},{"s":82,"a":2,"t":"وَإِذَا الْكَوَاكِبُ انْتَثَرَتْ"},{"s":82,"a":3,"t":"وَإِذَا الْبِحَارُ فُجِّرَتْ"},{"s":82,"a":4,"t":"وَإِذَا الْقُبُورُ بُعْثِرَتْ"},{"s":82,"a":5,"t":"عَلِمَتْ نَفْسٌ مَا قَدَّمَتْ وَأَخَّرَتْ"},{"s":82,"a":6,"t":"يَا أَيُّهَا الْإِنْسَانُ مَا غَرَّكَ بِرَبِّكَ الْكَرِيمِ"},{"s":82,"a":7,"t":"الَّذِي خَلَقَكَ فَسَوَّاكَ فَعَدَلَكَ"},{"s":82,"a":8,"t":"فِي أَيِّ صُورَةٍ مَا شَاءَ رَكَّبَكَ"},{"s":82,"a":9,"t":"كَلَّا بَلْ تُكَذِّبُونَ بِالدِّينِ"},{"s":82,"a":10,"t":"وَإِنَّ عَلَيْكُمْ لَحَافِظِينَ"},{"s":82,"a":11,"t":"كِرَامًا كَاتِبِينَ"},{"s":82,"a":12,"t":"يَعْلَمُونَ مَا تَفْعَلُونَ"},{"s":82,"a":13,"t":"إِنَّ الْأَبْرَارَ لَفِي نَعِيمٍ"},{"s":82,"a":14,"t":"وَإِنَّ الْفُجَّارَ لَفِي جَحِيمٍ"},{"s":82,"a":15,"t":"يَصْلَوْنَهَا يَوْمَ الدِّينِ"},{"s":82,"a":16,"t":"وَمَا هُمْ عَنْهَا بِغَائِبِينَ"},{"s":82,"a":17,"t":"وَمَا أَدْرَاكَ مَا يَوْمُ الدِّينِ"},{"s":82,"a":18,"t":"ثُمَّ مَا أَدْرَاكَ مَا يَوْمُ الدِّينِ"},{"s":82,"a":19,"t":"يَوْمَ لَا تَمْلِكُ نَفْسٌ لِنَفْسٍ شَيْئًا ۖ وَالْأَمْرُ يَوْمَئِذٍ لِلَّهِ"},{"s":83,"a":1,"t":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَيْلٌ لِلْمُطَفِّفِينَ"},{"s":83,"a":2,"t":"الَّذِينَ إِذَا اكْتَالُوا عَلَى النَّاسِ يَسْتَوْفُونَ"},{"s":83,"a":3,"t":"وَإِذَا كَالُوهُمْ أَوْ وَزَنُوهُمْ يُخْسِرُونَ"},{"s":83,"a":4,"t":"أَلَا يَظُنُّ أُولَٰئِكَ أَنَّهُمْ مَبْعُوثُونَ"},{"s":83,"a":5,"t":"لِيَوْمٍ عَظِيمٍ"},{"s":83,"a":6,"t":"يَوْمَ يَقُومُ النَّاسُ لِرَبِّ الْعَالَمِينَ"}]