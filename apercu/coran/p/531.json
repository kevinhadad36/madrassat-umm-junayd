[{"s":54,"a":50,"t":"وَمَا أَمْرُنَا إِلَّا وَاحِدَةٌ كَلَمْحٍ بِالْبَصَرِ"},{"s":54,"a":51,"t":"وَلَقَدْ أَهْلَكْنَا أَشْيَاعَكُمْ فَهَلْ مِنْ مُدَّكِرٍ"},{"s":54,"a":52,"t":"وَكُلُّ شَيْءٍ فَعَلُوهُ فِي الزُّبُرِ"},{"s":54,"a":53,"t":"وَكُلُّ صَغِيرٍ وَكَبِيرٍ مُسْتَطَرٌ"},{"s":54,"a":54,"t":"إِنَّ الْمُتَّقِينَ فِي جَنَّاتٍ وَنَهَرٍ"},{"s":54,"a":55,"t":"فِي مَقْعَدِ صِدْقٍ عِنْدَ مَلِيكٍ مُقْتَدِرٍ"},{"s":55,"a":1,"t":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ الرَّحْمَٰنُ"},{"s":55,"a":2,"t":"عَلَّمَ الْقُرْآنَ"},{"s":55,"a":3,"t":"خَلَقَ الْإِنْسَانَ"},{"s":55,"a":4,"t":"عَلَّمَهُ الْبَيَانَ"},{"s":55,"a":5,"t":"الشَّمْسُ وَالْقَمَرُ بِحُسْبَانٍ"},{"s":55,"a":6,"t":"وَالنَّجْمُ وَالشَّجَرُ يَسْجُدَانِ"},{"s":55,"a":7,"t":"وَالسَّمَاءَ رَفَعَهَا وَوَضَعَ الْمِيزَانَ"},{"s":55,"a":8,"t":"أَلَّا تَطْغَوْا فِي الْمِيزَانِ"},{"s":55,"a":9,"t":"وَأَقِيمُوا الْوَزْنَ بِالْقِسْطِ وَلَا تُخْسِرُوا الْمِيزَانَ"},{"s":55,"a":10,"t":"وَالْأَرْضَ وَضَعَهَا لِلْأَنَامِ"},{"s":55,"a":11,"t":"فِيهَا فَاكِهَةٌ وَالنَّخْلُ ذَاتُ الْأَكْمَامِ"},{"s":55,"a":12,"t":"وَالْحَبُّ ذُو الْعَصْفِ وَالرَّيْحَانُ"},{"s":55,"a":13,"t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"s":55,"a":14,"t":"خَلَقَ الْإِنْسَانَ مِنْ صَلْصَالٍ كَالْفَخَّارِ"},{"s":55,"a":15,"t":"وَخَلَقَ الْجَانَّ مِنْ مَارِجٍ مِنْ نَارٍ"},{"s":55,"a":16,"t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"}]