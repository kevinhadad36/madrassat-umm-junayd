[{"s":86,"a":1,"t":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالسَّمَاءِ وَالطَّارِقِ"},{"s":86,"a":2,"t":"وَمَا أَدْرَاكَ مَا الطَّارِقُ"},{"s":86,"a":3,"t":"النَّجْمُ الثَّاقِبُ"},{"s":86,"a":4,"t":"إِنْ كُلُّ نَفْسٍ لَمَّا عَلَيْهَا حَافِظٌ"},{"s":86,"a":5,"t":"فَلْيَنْظُرِ الْإِنْسَانُ مِمَّ خُلِقَ"},{"s":86,"a":6,"t":"خُلِقَ مِنْ مَاءٍ دَافِقٍ"},{"s":86,"a":7,"t":"يَخْرُجُ مِنْ بَيْنِ الصُّلْبِ وَالتَّرَائِبِ"},{"s":86,"a":8,"t":"إِنَّهُ عَلَىٰ رَجْعِهِ لَقَادِرٌ"},{"s":86,"a":9,"t":"يَوْمَ تُبْلَى السَّرَائِرُ"},{"s":86,"a":10,"t":"فَمَا لَهُ مِنْ قُوَّةٍ وَلَا نَاصِرٍ"},{"s":86,"a":11,"t":"وَالسَّمَاءِ ذَاتِ الرَّجْعِ"},{"s":86,"a":12,"t":"وَالْأَرْضِ ذَاتِ الصَّدْعِ"},{"s":86,"a":13,"t":"إِنَّهُ لَقَوْلٌ فَصْلٌ"},{"s":86,"a":14,"t":"وَمَا هُوَ بِالْهَزْلِ"},{"s":86,"a":15,"t":"إِنَّهُمْ يَكِيدُونَ كَيْدًا"},{"s":86,"a":16,"t":"وَأَكِيدُ كَيْدًا"},{"s":86,"a":17,"t":"فَمَهِّلِ الْكَافِرِينَ أَمْهِلْهُمْ رُوَيْدًا"},{"s":87,"a":1,"t":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى"},{"s":87,"a":2,"t":"الَّذِي خَلَقَ فَسَوَّىٰ"},{"s":87,"a":3,"t":"وَالَّذِي قَدَّرَ فَهَدَىٰ"},{"s":87,"a":4,"t":"وَالَّذِي أَخْرَجَ الْمَرْعَىٰ"},{"s":87,"a":5,"t":"فَجَعَلَهُ غُثَاءً أَحْوَىٰ"},{"s":87,"a":6,"t":"سَنُقْرِئُكَ فَلَا تَنْسَىٰ"},{"s":87,"a":7,"t":"إِلَّا مَا شَاءَ اللَّهُ ۚ إِنَّهُ يَعْلَمُ الْجَهْرَ وَمَا يَخْفَىٰ"},{"s":87,"a":8,"t":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ"},{"s":87,"a":9,"t":"فَذَكِّرْ إِنْ نَفَعَتِ الذِّكْرَىٰ"},{"s":87,"a":10,"t":"سَيَذَّكَّرُ مَنْ يَخْشَىٰ"},{"s":87,"a":11,"t":"وَيَتَجَنَّبُهَا الْأَشْقَى"},{"s":87,"a":12,"t":"الَّذِي يَصْلَى النَّارَ الْكُبْرَىٰ"},{"s":87,"a":13,"t":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ"},{"s":87,"a":14,"t":"قَدْ أَفْلَحَ مَنْ تَزَكَّىٰ"},{"s":87,"a":15,"t":"وَذَكَرَ اسْمَ رَبِّهِ فَصَلَّىٰ"}]