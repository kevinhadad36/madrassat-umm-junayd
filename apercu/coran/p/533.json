[{"s":55,"a":41,"t":"يُعْرَفُ الْمُجْرِمُونَ بِسِيمَاهُمْ فَيُؤْخَذُ بِالنَّوَاصِي وَالْأَقْدَامِ"},{"s":55,"a":42,"t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"s":55,"a":43,"t":"هَٰذِهِ جَهَنَّمُ الَّتِي يُكَذِّبُ بِهَا الْمُجْرِمُونَ"},{"s":55,"a":44,"t":"يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ آنٍ"},{"s":55,"a":45,"t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"s":55,"a":46,"t":"وَلِمَنْ خَافَ مَقَامَ رَبِّهِ جَنَّتَانِ"},{"s":55,"a":47,"t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"s":55,"a":48,"t":"ذَوَاتَا أَفْنَانٍ"},{"s":55,"a":49,"t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"s":55,"a":50,"t":"فِيهِمَا عَيْنَانِ تَجْرِيَانِ"},{"s":55,"a":51,"t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"s":55,"a":52,"t":"فِيهِمَا مِنْ كُلِّ فَاكِهَةٍ زَوْجَانِ"},{"s":55,"a":53,"t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"s":55,"a":54,"t":"مُتَّكِئِينَ عَلَىٰ فُرُشٍ بَطَائِنُهَا مِنْ إِسْتَبْرَقٍ ۚ وَجَنَى الْجَنَّتَيْنِ دَانٍ"},{"s":55,"a":55,"t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"s":55,"a":56,"t":"فِيهِنَّ قَاصِرَاتُ الطَّرْفِ لَمْ يَطْمِثْهُنَّ إِنْسٌ قَبْلَهُمْ وَلَا جَانٌّ"},{"s":55,"a":57,"t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"s":55,"a":58,"t":"كَأَنَّهُنَّ الْيَاقُوتُ وَالْمَرْجَانُ"},{"s":55,"a":59,"t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"s":55,"a":60,"t":"هَلْ جَزَاءُ الْإِحْسَانِ إِلَّا الْإِحْسَانُ"},{"s":55,"a":61,"t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"s":55,"a":62,"t":"وَمِنْ دُونِهِمَا جَنَّتَانِ"},{"s":55,"a":63,"t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"s":55,"a":64,"t":"مُدْهَامَّتَانِ"},{"s":55,"a":65,"t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"s":55,"a":66,"t":"فِيهِمَا عَيْنَانِ نَضَّاخَتَانِ"},{"s":55,"a":67,"t":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"}]