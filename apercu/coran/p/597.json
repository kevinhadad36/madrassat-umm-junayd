[{"s":95,"a":1,"t":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالتِّينِ وَالزَّيْتُونِ"},{"s":95,"a":2,"t":"وَطُورِ سِينِينَ"},{"s":95,"a":3,"t":"وَهَٰذَا الْبَلَدِ الْأَمِينِ"},{"s":95,"a":4,"t":"لَقَدْ خَلَقْنَا الْإِنْسَانَ فِي أَحْسَنِ تَقْوِيمٍ"},{"s":95,"a":5,"t":"ثُمَّ رَدَدْنَاهُ أَسْفَلَ سَافِلِينَ"},{"s":95,"a":6,"t":"إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ"},{"s":95,"a":7,"t":"فَمَا يُكَذِّبُكَ بَعْدُ بِالدِّينِ"},{"s":95,"a":8,"t":"أَلَيْسَ اللَّهُ بِأَحْكَمِ الْحَاكِمِينَ"},{"s":96,"a":1,"t":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ اقْرَأْ بِاسْمِ رَبِّكَ الَّذِي خَلَقَ"},{"s":96,"a":2,"t":"خَلَقَ الْإِنْسَانَ مِنْ عَلَقٍ"},{"s":96,"a":3,"t":"اقْرَأْ وَرَبُّكَ الْأَكْرَمُ"},{"s":96,"a":4,"t":"الَّذِي عَلَّمَ بِالْقَلَمِ"},{"s":96,"a":5,"t":"عَلَّمَ الْإِنْسَانَ مَا لَمْ يَعْلَمْ"},{"s":96,"a":6,"t":"كَلَّا إِنَّ الْإِنْسَانَ لَيَطْغَىٰ"},{"s":96,"a":7,"t":"أَنْ رَآهُ اسْتَغْنَىٰ"},{"s":96,"a":8,"t":"إِنَّ إِلَىٰ رَبِّكَ الرُّجْعَىٰ"},{"s":96,"a":9,"t":"أَرَأَيْتَ الَّذِي يَنْهَىٰ"},{"s":96,"a":10,"t":"عَبْدًا إِذَا صَلَّىٰ"},{"s":96,"a":11,"t":"أَرَأَيْتَ إِنْ كَانَ عَلَى الْهُدَىٰ"},{"s":96,"a":12,"t":"أَوْ أَمَرَ بِالتَّقْوَىٰ"},{"s":96,"a":13,"t":"أَرَأَيْتَ إِنْ كَذَّبَ وَتَوَلَّىٰ"},{"s":96,"a":14,"t":"أَلَمْ يَعْلَمْ بِأَنَّ اللَّهَ يَرَىٰ"},{"s":96,"a":15,"t":"كَلَّا لَئِنْ لَمْ يَنْتَهِ لَنَسْفَعًا بِالنَّاصِيَةِ"},{"s":96,"a":16,"t":"نَاصِيَةٍ كَاذِبَةٍ خَاطِئَةٍ"},{"s":96,"a":17,"t":"فَلْيَدْعُ نَادِيَهُ"},{"s":96,"a":18,"t":"سَنَدْعُ الزَّبَانِيَةَ"},{"s":96,"a":19,"t":"كَلَّا لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبْ ۩"}]