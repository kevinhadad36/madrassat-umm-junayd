[{"s":56,"a":77,"t":"إِنَّهُ لَقُرْآنٌ كَرِيمٌ"},{"s":56,"a":78,"t":"فِي كِتَابٍ مَكْنُونٍ"},{"s":56,"a":79,"t":"لَا يَمَسُّهُ إِلَّا الْمُطَهَّرُونَ"},{"s":56,"a":80,"t":"تَنْزِيلٌ مِنْ رَبِّ الْعَالَمِينَ"},{"s":56,"a":81,"t":"أَفَبِهَٰذَا الْحَدِيثِ أَنْتُمْ مُدْهِنُونَ"},{"s":56,"a":82,"t":"وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ"},{"s":56,"a":83,"t":"فَلَوْلَا إِذَا بَلَغَتِ الْحُلْقُومَ"},{"s":56,"a":84,"t":"وَأَنْتُمْ حِينَئِذٍ تَنْظُرُونَ"},{"s":56,"a":85,"t":"وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنْكُمْ وَلَٰكِنْ لَا تُبْصِرُونَ"},{"s":56,"a":86,"t":"فَلَوْلَا إِنْ كُنْتُمْ غَيْرَ مَدِينِينَ"},{"s":56,"a":87,"t":"تَرْجِعُونَهَا إِنْ كُنْتُمْ صَادِقِينَ"},{"s":56,"a":88,"t":"فَأَمَّا إِنْ كَانَ مِنَ الْمُقَرَّبِينَ"},{"s":56,"a":89,"t":"فَرَوْحٌ وَرَيْحَانٌ وَجَنَّتُ نَعِيمٍ"},{"s":56,"a":90,"t":"وَأَمَّا إِنْ كَانَ مِنْ أَصْحَابِ الْيَمِينِ"},{"s":56,"a":91,"t":"فَسَلَامٌ لَكَ مِنْ أَصْحَابِ الْيَمِينِ"},{"s":56,"a":92,"t":"وَأَمَّا إِنْ كَانَ مِنَ الْمُكَذِّبِينَ الضَّالِّينَ"},{"s":56,"a":93,"t":"فَنُزُلٌ مِنْ حَمِيمٍ"},{"s":56,"a":94,"t":"وَتَصْلِيَةُ جَحِيمٍ"},{"s":56,"a":95,"t":"إِنَّ هَٰذَا لَهُوَ حَقُّ الْيَقِينِ"},{"s":56,"a":96,"t":"فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظِيمِ"},{"s":57,"a":1,"t":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ سَبَّحَ لِلَّهِ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ ۖ وَهُوَ الْعَزِيزُ الْحَكِيمُ"},{"s":57,"a":2,"t":"لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ ۖ يُحْيِي وَيُمِيتُ ۖ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ"},{"s":57,"a":3,"t":"هُوَ الْأَوَّلُ وَالْآخِرُ وَالظَّاهِرُ وَالْبَاطِنُ ۖ وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ"}]