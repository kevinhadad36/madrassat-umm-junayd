[{"s":74,"a":48,"t":"فَمَا تَنْفَعُهُمْ شَفَاعَةُ الشَّافِعِينَ"},{"s":74,"a":49,"t":"فَمَا لَهُمْ عَنِ التَّذْكِرَةِ مُعْرِضِينَ"},{"s":74,"a":50,"t":"كَأَنَّهُمْ حُمُرٌ مُسْتَنْفِرَةٌ"},{"s":74,"a":51,"t":"فَرَّتْ مِنْ قَسْوَرَةٍ"},{"s":74,"a":52,"t":"بَلْ يُرِيدُ كُلُّ امْرِئٍ مِنْهُمْ أَنْ يُؤْتَىٰ صُحُفًا مُنَشَّرَةً"},{"s":74,"a":53,"t":"كَلَّا ۖ بَلْ لَا يَخَافُونَ الْآخِرَةَ"},{"s":74,"a":54,"t":"كَلَّا إِنَّهُ تَذْكِرَةٌ"},{"s":74,"a":55,"t":"فَمَنْ شَاءَ ذَكَرَهُ"},{"s":74,"a":56,"t":"وَمَا يَذْكُرُونَ إِلَّا أَنْ يَشَاءَ اللَّهُ ۚ هُوَ أَهْلُ التَّقْوَىٰ وَأَهْلُ الْمَغْفِرَةِ"},{"s":75,"a":1,"t":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ لَا أُقْسِمُ بِيَوْمِ الْقِيَامَةِ"},{"s":75,"a":2,"t":"وَلَا أُقْسِمُ بِالنَّفْسِ اللَّوَّامَةِ"},{"s":75,"a":3,"t":"أَيَحْسَبُ الْإِنْسَانُ أَلَّنْ نَجْمَعَ عِظَامَهُ"},{"s":75,"a":4,"t":"بَلَىٰ قَادِرِينَ عَلَىٰ أَنْ نُسَوِّيَ بَنَانَهُ"},{"s":75,"a":5,"t":"بَلْ يُرِيدُ الْإِنْسَانُ لِيَفْجُرَ أَمَامَهُ"},{"s":75,"a":6,"t":"يَسْأَلُ أَيَّانَ يَوْمُ الْقِيَامَةِ"},{"s":75,"a":7,"t":"فَإِذَا بَرِقَ الْبَصَرُ"},{"s":75,"a":8,"t":"وَخَسَفَ الْقَمَرُ"},{"s":75,"a":9,"t":"وَجُمِعَ الشَّمْسُ وَالْقَمَرُ"},{"s":75,"a":10,"t":"يَقُولُ الْإِنْسَانُ يَوْمَئِذٍ أَيْنَ الْمَفَرُّ"},{"s":75,"a":11,"t":"كَلَّا لَا وَزَرَ"},{"s":75,"a":12,"t":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ الْمُسْتَقَرُّ"},{"s":75,"a":13,"t":"يُنَبَّأُ الْإِنْسَانُ يَوْمَئِذٍ بِمَا قَدَّمَ وَأَخَّرَ"},{"s":75,"a":14,"t":"بَلِ الْإِنْسَانُ عَلَىٰ نَفْسِهِ بَصِيرَةٌ"},{"s":75,"a":15,"t":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُ"},{"s":75,"a":16,"t":"لَا تُحَرِّكْ بِهِ لِسَانَكَ لِتَعْجَلَ بِهِ"},{"s":75,"a":17,"t":"إِنَّ عَلَيْنَا جَمْعَهُ وَقُرْآنَهُ"},{"s":75,"a":18,"t":"فَإِذَا قَرَأْنَاهُ فَاتَّبِعْ قُرْآنَهُ"},{"s":75,"a":19,"t":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُ"}]