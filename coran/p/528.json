[{"s":53,"a":45,"t":"وَأَنَّهُ خَلَقَ الزَّوْجَيْنِ الذَّكَرَ وَالْأُنْثَىٰ"},{"s":53,"a":46,"t":"مِنْ نُطْفَةٍ إِذَا تُمْنَىٰ"},{"s":53,"a":47,"t":"وَأَنَّ عَلَيْهِ النَّشْأَةَ الْأُخْرَىٰ"},{"s":53,"a":48,"t":"وَأَنَّهُ هُوَ أَغْنَىٰ وَأَقْنَىٰ"},{"s":53,"a":49,"t":"وَأَنَّهُ هُوَ رَبُّ الشِّعْرَىٰ"},{"s":53,"a":50,"t":"وَأَنَّهُ أَهْلَكَ عَادًا الْأُولَىٰ"},{"s":53,"a":51,"t":"وَثَمُودَ فَمَا أَبْقَىٰ"},{"s":53,"a":52,"t":"وَقَوْمَ نُوحٍ مِنْ قَبْلُ ۖ إِنَّهُمْ كَانُوا هُمْ أَظْلَمَ وَأَطْغَىٰ"},{"s":53,"a":53,"t":"وَالْمُؤْتَفِكَةَ أَهْوَىٰ"},{"s":53,"a":54,"t":"فَغَشَّاهَا مَا غَشَّىٰ"},{"s":53,"a":55,"t":"فَبِأَيِّ آلَاءِ رَبِّكَ تَتَمَارَىٰ"},{"s":53,"a":56,"t":"هَٰذَا نَذِيرٌ مِنَ النُّذُرِ الْأُولَىٰ"},{"s":53,"a":57,"t":"أَزِفَتِ الْآزِفَةُ"},{"s":53,"a":58,"t":"لَيْسَ لَهَا مِنْ دُونِ اللَّهِ كَاشِفَةٌ"},{"s":53,"a":59,"t":"أَفَمِنْ هَٰذَا الْحَدِيثِ تَعْجَبُونَ"},{"s":53,"a":60,"t":"وَتَضْحَكُونَ وَلَا تَبْكُونَ"},{"s":53,"a":61,"t":"وَأَنْتُمْ سَامِدُونَ"},{"s":53,"a":62,"t":"فَاسْجُدُوا لِلَّهِ وَاعْبُدُوا ۩"},{"s":54,"a":1,"t":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ اقْتَرَبَتِ السَّاعَةُ وَانْشَقَّ الْقَمَرُ"},{"s":54,"a":2,"t":"وَإِنْ يَرَوْا آيَةً يُعْرِضُوا وَيَقُولُوا سِحْرٌ مُسْتَمِرٌّ"},{"s":54,"a":3,"t":"وَكَذَّبُوا وَاتَّبَعُوا أَهْوَاءَهُمْ ۚ وَكُلُّ أَمْرٍ مُسْتَقِرٌّ"},{"s":54,"a":4,"t":"وَلَقَدْ جَاءَهُمْ مِنَ الْأَنْبَاءِ مَا فِيهِ مُزْدَجَرٌ"},{"s":54,"a":5,"t":"حِكْمَةٌ بَالِغَةٌ ۖ فَمَا تُغْنِ النُّذُرُ"},{"s":54,"a":6,"t":"فَتَوَلَّ عَنْهُمْ ۘ يَوْمَ يَدْعُ الدَّاعِ إِلَىٰ شَيْءٍ نُكُرٍ"}]