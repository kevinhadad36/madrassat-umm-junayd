[{"s":37,"a":52,"t":"يَقُولُ أَإِنَّكَ لَمِنَ الْمُصَدِّقِينَ"},{"s":37,"a":53,"t":"أَإِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَامًا أَإِنَّا لَمَدِينُونَ"},{"s":37,"a":54,"t":"قَالَ هَلْ أَنْتُمْ مُطَّلِعُونَ"},{"s":37,"a":55,"t":"فَاطَّلَعَ فَرَآهُ فِي سَوَاءِ الْجَحِيمِ"},{"s":37,"a":56,"t":"قَالَ تَاللَّهِ إِنْ كِدْتَ لَتُرْدِينِ"},{"s":37,"a":57,"t":"وَلَوْلَا نِعْمَةُ رَبِّي لَكُنْتُ مِنَ الْمُحْضَرِينَ"},{"s":37,"a":58,"t":"أَفَمَا نَحْنُ بِمَيِّتِينَ"},{"s":37,"a":59,"t":"إِلَّا مَوْتَتَنَا الْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَ"},{"s":37,"a":60,"t":"إِنَّ هَٰذَا لَهُوَ الْفَوْزُ الْعَظِيمُ"},{"s":37,"a":61,"t":"لِمِثْلِ هَٰذَا فَلْيَعْمَلِ الْعَامِلُونَ"},{"s":37,"a":62,"t":"أَذَٰلِكَ خَيْرٌ نُزُلًا أَمْ شَجَرَةُ الزَّقُّومِ"},{"s":37,"a":63,"t":"إِنَّا جَعَلْنَاهَا فِتْنَةً لِلظَّالِمِينَ"},{"s":37,"a":64,"t":"إِنَّهَا شَجَرَةٌ تَخْرُجُ فِي أَصْلِ الْجَحِيمِ"},{"s":37,"a":65,"t":"طَلْعُهَا كَأَنَّهُ رُءُوسُ الشَّيَاطِينِ"},{"s":37,"a":66,"t":"فَإِنَّهُمْ لَآكِلُونَ مِنْهَا فَمَالِئُونَ مِنْهَا الْبُطُونَ"},{"s":37,"a":67,"t":"ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًا مِنْ حَمِيمٍ"},{"s":37,"a":68,"t":"ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى الْجَحِيمِ"},{"s":37,"a":69,"t":"إِنَّهُمْ أَلْفَوْا آبَاءَهُمْ ضَالِّينَ"},{"s":37,"a":70,"t":"فَهُمْ عَلَىٰ آثَارِهِمْ يُهْرَعُونَ"},{"s":37,"a":71,"t":"وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ الْأَوَّلِينَ"},{"s":37,"a":72,"t":"وَلَقَدْ أَرْسَلْنَا فِيهِمْ مُنْذِرِينَ"},{"s":37,"a":73,"t":"فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الْمُنْذَرِينَ"},{"s":37,"a":74,"t":"إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ"},{"s":37,"a":75,"t":"وَلَقَدْ نَادَانَا نُوحٌ فَلَنِعْمَ الْمُجِيبُونَ"},{"s":37,"a":76,"t":"وَنَجَّيْنَاهُ وَأَهْلَهُ مِنَ الْكَرْبِ الْعَظِيمِ"}]