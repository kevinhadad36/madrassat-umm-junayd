[{"s":83,"a":35,"t":"عَلَى الْأَرَائِكِ يَنْظُرُونَ"},{"s":83,"a":36,"t":"هَلْ ثُوِّبَ الْكُفَّارُ مَا كَانُوا يَفْعَلُونَ"},{"s":84,"a":1,"t":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ إِذَا السَّمَاءُ انْشَقَّتْ"},{"s":84,"a":2,"t":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"},{"s":84,"a":3,"t":"وَإِذَا الْأَرْضُ مُدَّتْ"},{"s":84,"a":4,"t":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ"},{"s":84,"a":5,"t":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"},{"s":84,"a":6,"t":"يَا أَيُّهَا الْإِنْسَانُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَاقِيهِ"},{"s":84,"a":7,"t":"فَأَمَّا مَنْ أُوتِيَ كِتَابَهُ بِيَمِينِهِ"},{"s":84,"a":8,"t":"فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا"},{"s":84,"a":9,"t":"وَيَنْقَلِبُ إِلَىٰ أَهْلِهِ مَسْرُورًا"},{"s":84,"a":10,"t":"وَأَمَّا مَنْ أُوتِيَ كِتَابَهُ وَرَاءَ ظَهْرِهِ"},{"s":84,"a":11,"t":"فَسَوْفَ يَدْعُو ثُبُورًا"},{"s":84,"a":12,"t":"وَيَصْلَىٰ سَعِيرًا"},{"s":84,"a":13,"t":"إِنَّهُ كَانَ فِي أَهْلِهِ مَسْرُورًا"},{"s":84,"a":14,"t":"إِنَّهُ ظَنَّ أَنْ لَنْ يَحُورَ"},{"s":84,"a":15,"t":"بَلَىٰ إِنَّ رَبَّهُ كَانَ بِهِ بَصِيرًا"},{"s":84,"a":16,"t":"فَلَا أُقْسِمُ بِالشَّفَقِ"},{"s":84,"a":17,"t":"وَاللَّيْلِ وَمَا وَسَقَ"},{"s":84,"a":18,"t":"وَالْقَمَرِ إِذَا اتَّسَقَ"},{"s":84,"a":19,"t":"لَتَرْكَبُنَّ طَبَقًا عَنْ طَبَقٍ"},{"s":84,"a":20,"t":"فَمَا لَهُمْ لَا يُؤْمِنُونَ"},{"s":84,"a":21,"t":"وَإِذَا قُرِئَ عَلَيْهِمُ الْقُرْآنُ لَا يَسْجُدُونَ ۩"},{"s":84,"a":22,"t":"بَلِ الَّذِينَ كَفَرُوا يُكَذِّبُونَ"},{"s":84,"a":23,"t":"وَاللَّهُ أَعْلَمُ بِمَا يُوعُونَ"},{"s":84,"a":24,"t":"فَبَشِّرْهُمْ بِعَذَابٍ أَلِيمٍ"},{"s":84,"a":25,"t":"إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ"}]