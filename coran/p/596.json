[{"s":92,"a":15,"t":"لَا يَصْلَاهَا إِلَّا الْأَشْقَى"},{"s":92,"a":16,"t":"الَّذِي كَذَّبَ وَتَوَلَّىٰ"},{"s":92,"a":17,"t":"وَسَيُجَنَّبُهَا الْأَتْقَى"},{"s":92,"a":18,"t":"الَّذِي يُؤْتِي مَالَهُ يَتَزَكَّىٰ"},{"s":92,"a":19,"t":"وَمَا لِأَحَدٍ عِنْدَهُ مِنْ نِعْمَةٍ تُجْزَىٰ"},{"s":92,"a":20,"t":"إِلَّا ابْتِغَاءَ وَجْهِ رَبِّهِ الْأَعْلَىٰ"},{"s":92,"a":21,"t":"وَلَسَوْفَ يَرْضَىٰ"},{"s":93,"a":1,"t":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالضُّحَىٰ"},{"s":93,"a":2,"t":"وَاللَّيْلِ إِذَا سَجَىٰ"},{"s":93,"a":3,"t":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ"},{"s":93,"a":4,"t":"وَلَلْآخِرَةُ خَيْرٌ لَكَ مِنَ الْأُولَىٰ"},{"s":93,"a":5,"t":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰ"},{"s":93,"a":6,"t":"أَلَمْ يَجِدْكَ يَتِيمًا فَآوَىٰ"},{"s":93,"a":7,"t":"وَوَجَدَكَ ضَالًّا فَهَدَىٰ"},{"s":93,"a":8,"t":"وَوَجَدَكَ عَائِلًا فَأَغْنَىٰ"},{"s":93,"a":9,"t":"فَأَمَّا الْيَتِيمَ فَلَا تَقْهَرْ"},{"s":93,"a":10,"t":"وَأَمَّا السَّائِلَ فَلَا تَنْهَرْ"},{"s":93,"a":11,"t":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ"},{"s":94,"a":1,"t":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ"},{"s":94,"a":2,"t":"وَوَضَعْنَا عَنْكَ وِزْرَكَ"},{"s":94,"a":3,"t":"الَّذِي أَنْقَضَ ظَهْرَكَ"},{"s":94,"a":4,"t":"وَرَفَعْنَا لَكَ ذِكْرَكَ"},{"s":94,"a":5,"t":"فَإِنَّ مَعَ الْعُسْرِ يُسْرًا"},{"s":94,"a":6,"t":"إِنَّ مَعَ الْعُسْرِ يُسْرًا"},{"s":94,"a":7,"t":"فَإِذَا فَرَغْتَ فَانْصَبْ"},{"s":94,"a":8,"t":"وَإِلَىٰ رَبِّكَ فَارْغَبْ"}]