[{"s":53,"a":1,"t":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالنَّجْمِ إِذَا هَوَىٰ"},{"s":53,"a":2,"t":"مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوَىٰ"},{"s":53,"a":3,"t":"وَمَا يَنْطِقُ عَنِ الْهَوَىٰ"},{"s":53,"a":4,"t":"إِنْ هُوَ إِلَّا وَحْيٌ يُوحَىٰ"},{"s":53,"a":5,"t":"عَلَّمَهُ شَدِيدُ الْقُوَىٰ"},{"s":53,"a":6,"t":"ذُو مِرَّةٍ فَاسْتَوَىٰ"},{"s":53,"a":7,"t":"وَهُوَ بِالْأُفُقِ الْأَعْلَىٰ"},{"s":53,"a":8,"t":"ثُمَّ دَنَا فَتَدَلَّىٰ"},{"s":53,"a":9,"t":"فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَىٰ"},{"s":53,"a":10,"t":"فَأَوْحَىٰ إِلَىٰ عَبْدِهِ مَا أَوْحَىٰ"},{"s":53,"a":11,"t":"مَا كَذَبَ الْفُؤَادُ مَا رَأَىٰ"},{"s":53,"a":12,"t":"أَفَتُمَارُونَهُ عَلَىٰ مَا يَرَىٰ"},{"s":53,"a":13,"t":"وَلَقَدْ رَآهُ نَزْلَةً أُخْرَىٰ"},{"s":53,"a":14,"t":"عِنْدَ سِدْرَةِ الْمُنْتَهَىٰ"},{"s":53,"a":15,"t":"عِنْدَهَا جَنَّةُ الْمَأْوَىٰ"},{"s":53,"a":16,"t":"إِذْ يَغْشَى السِّدْرَةَ مَا يَغْشَىٰ"},{"s":53,"a":17,"t":"مَا زَاغَ الْبَصَرُ وَمَا طَغَىٰ"},{"s":53,"a":18,"t":"لَقَدْ رَأَىٰ مِنْ آيَاتِ رَبِّهِ الْكُبْرَىٰ"},{"s":53,"a":19,"t":"أَفَرَأَيْتُمُ اللَّاتَ وَالْعُزَّىٰ"},{"s":53,"a":20,"t":"وَمَنَاةَ الثَّالِثَةَ الْأُخْرَىٰ"},{"s":53,"a":21,"t":"أَلَكُمُ الذَّكَرُ وَلَهُ الْأُنْثَىٰ"},{"s":53,"a":22,"t":"تِلْكَ إِذًا قِسْمَةٌ ضِيزَىٰ"},{"s":53,"a":23,"t":"إِنْ هِيَ إِلَّا أَسْمَاءٌ سَمَّيْتُمُوهَا أَنْتُمْ وَآبَاؤُكُمْ مَا أَنْزَلَ اللَّهُ بِهَا مِنْ سُلْطَانٍ ۚ إِنْ يَتَّبِعُونَ إِلَّا الظَّنَّ وَمَا تَهْوَى الْأَنْفُسُ ۖ وَلَقَدْ جَاءَهُمْ مِنْ رَبِّهِمُ الْهُدَىٰ"},{"s":53,"a":24,"t":"أَمْ لِلْإِنْسَانِ مَا تَمَنَّىٰ"},{"s":53,"a":25,"t":"فَلِلَّهِ الْآخِرَةُ وَالْأُولَىٰ"},{"s":53,"a":26,"t":"۞ وَكَمْ مِنْ مَلَكٍ فِي السَّمَاوَاتِ لَا تُغْنِي شَفَاعَتُهُمْ شَيْئًا إِلَّا مِنْ بَعْدِ أَنْ يَأْذَنَ اللَّهُ لِمَنْ يَشَاءُ وَيَرْضَىٰ"}]