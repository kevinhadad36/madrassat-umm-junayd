[{"s":44,"a":40,"t":"إِنَّ يَوْمَ الْفَصْلِ مِيقَاتُهُمْ أَجْمَعِينَ"},{"s":44,"a":41,"t":"يَوْمَ لَا يُغْنِي مَوْلًى عَنْ مَوْلًى شَيْئًا وَلَا هُمْ يُنْصَرُونَ"},{"s":44,"a":42,"t":"إِلَّا مَنْ رَحِمَ اللَّهُ ۚ إِنَّهُ هُوَ الْعَزِيزُ الرَّحِيمُ"},{"s":44,"a":43,"t":"إِنَّ شَجَرَتَ الزَّقُّومِ"},{"s":44,"a":44,"t":"طَعَامُ الْأَثِيمِ"},{"s":44,"a":45,"t":"كَالْمُهْلِ يَغْلِي فِي الْبُطُونِ"},{"s":44,"a":46,"t":"كَغَلْيِ الْحَمِيمِ"},{"s":44,"a":47,"t":"خُذُوهُ فَاعْتِلُوهُ إِلَىٰ سَوَاءِ الْجَحِيمِ"},{"s":44,"a":48,"t":"ثُمَّ صُبُّوا فَوْقَ رَأْسِهِ مِنْ عَذَابِ الْحَمِيمِ"},{"s":44,"a":49,"t":"ذُقْ إِنَّكَ أَنْتَ الْعَزِيزُ الْكَرِيمُ"},{"s":44,"a":50,"t":"إِنَّ هَٰذَا مَا كُنْتُمْ بِهِ تَمْتَرُونَ"},{"s":44,"a":51,"t":"إِنَّ الْمُتَّقِينَ فِي مَقَامٍ أَمِينٍ"},{"s":44,"a":52,"t":"فِي جَنَّاتٍ وَعُيُونٍ"},{"s":44,"a":53,"t":"يَلْبَسُونَ مِنْ سُنْدُسٍ وَإِسْتَبْرَقٍ مُتَقَابِلِينَ"},{"s":44,"a":54,"t":"كَذَٰلِكَ وَزَوَّجْنَاهُمْ بِحُورٍ عِينٍ"},{"s":44,"a":55,"t":"يَدْعُونَ فِيهَا بِكُلِّ فَاكِهَةٍ آمِنِينَ"},{"s":44,"a":56,"t":"لَا يَذُوقُونَ فِيهَا الْمَوْتَ إِلَّا الْمَوْتَةَ الْأُولَىٰ ۖ وَوَقَاهُمْ عَذَابَ الْجَحِيمِ"},{"s":44,"a":57,"t":"فَضْلًا مِنْ رَبِّكَ ۚ ذَٰلِكَ هُوَ الْفَوْزُ الْعَظِيمُ"},{"s":44,"a":58,"t":"فَإِنَّمَا يَسَّرْنَاهُ بِلِسَانِكَ لَعَلَّهُمْ يَتَذَكَّرُونَ"},{"s":44,"a":59,"t":"فَارْتَقِبْ إِنَّهُمْ مُرْتَقِبُونَ"}]