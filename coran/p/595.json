[{"s":91,"a":1,"t":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالشَّمْسِ وَضُحَاهَا"},{"s":91,"a":2,"t":"وَالْقَمَرِ إِذَا تَلَاهَا"},{"s":91,"a":3,"t":"وَالنَّهَارِ إِذَا جَلَّاهَا"},{"s":91,"a":4,"t":"وَاللَّيْلِ إِذَا يَغْشَاهَا"},{"s":91,"a":5,"t":"وَالسَّمَاءِ وَمَا بَنَاهَا"},{"s":91,"a":6,"t":"وَالْأَرْضِ وَمَا طَحَاهَا"},{"s":91,"a":7,"t":"وَنَفْسٍ وَمَا سَوَّاهَا"},{"s":91,"a":8,"t":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَاهَا"},{"s":91,"a":9,"t":"قَدْ أَفْلَحَ مَنْ زَكَّاهَا"},{"s":91,"a":10,"t":"وَقَدْ خَابَ مَنْ دَسَّاهَا"},{"s":91,"a":11,"t":"كَذَّبَتْ ثَمُودُ بِطَغْوَاهَا"},{"s":91,"a":12,"t":"إِذِ انْبَعَثَ أَشْقَاهَا"},{"s":91,"a":13,"t":"فَقَالَ لَهُمْ رَسُولُ اللَّهِ نَاقَةَ اللَّهِ وَسُقْيَاهَا"},{"s":91,"a":14,"t":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُمْ بِذَنْبِهِمْ فَسَوَّاهَا"},{"s":91,"a":15,"t":"وَلَا يَخَافُ عُقْبَاهَا"},{"s":92,"a":1,"t":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَاللَّيْلِ إِذَا يَغْشَىٰ"},{"s":92,"a":2,"t":"وَالنَّهَارِ إِذَا تَجَلَّىٰ"},{"s":92,"a":3,"t":"وَمَا خَلَقَ الذَّكَرَ وَالْأُنْثَىٰ"},{"s":92,"a":4,"t":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ"},{"s":92,"a":5,"t":"فَأَمَّا مَنْ أَعْطَىٰ وَاتَّقَىٰ"},{"s":92,"a":6,"t":"وَصَدَّقَ بِالْحُسْنَىٰ"},{"s":92,"a":7,"t":"فَسَنُيَسِّرُهُ لِلْيُسْرَىٰ"},{"s":92,"a":8,"t":"وَأَمَّا مَنْ بَخِلَ وَاسْتَغْنَىٰ"},{"s":92,"a":9,"t":"وَكَذَّبَ بِالْحُسْنَىٰ"},{"s":92,"a":10,"t":"فَسَنُيَسِّرُهُ لِلْعُسْرَىٰ"},{"s":92,"a":11,"t":"وَمَا يُغْنِي عَنْهُ مَالُهُ إِذَا تَرَدَّىٰ"},{"s":92,"a":12,"t":"إِنَّ عَلَيْنَا لَلْهُدَىٰ"},{"s":92,"a":13,"t":"وَإِنَّ لَنَا لَلْآخِرَةَ وَالْأُولَىٰ"},{"s":92,"a":14,"t":"فَأَنْذَرْتُكُمْ نَارًا تَلَظَّىٰ"}]