[{"s":56,"a":51,"t":"ثُمَّ إِنَّكُمْ أَيُّهَا الضَّالُّونَ الْمُكَذِّبُونَ"},{"s":56,"a":52,"t":"لَآكِلُونَ مِنْ شَجَرٍ مِنْ زَقُّومٍ"},{"s":56,"a":53,"t":"فَمَالِئُونَ مِنْهَا الْبُطُونَ"},{"s":56,"a":54,"t":"فَشَارِبُونَ عَلَيْهِ مِنَ الْحَمِيمِ"},{"s":56,"a":55,"t":"فَشَارِبُونَ شُرْبَ الْهِيمِ"},{"s":56,"a":56,"t":"هَٰذَا نُزُلُهُمْ يَوْمَ الدِّينِ"},{"s":56,"a":57,"t":"نَحْنُ خَلَقْنَاكُمْ فَلَوْلَا تُصَدِّقُونَ"},{"s":56,"a":58,"t":"أَفَرَأَيْتُمْ مَا تُمْنُونَ"},{"s":56,"a":59,"t":"أَأَنْتُمْ تَخْلُقُونَهُ أَمْ نَحْنُ الْخَالِقُونَ"},{"s":56,"a":60,"t":"نَحْنُ قَدَّرْنَا بَيْنَكُمُ الْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ"},{"s":56,"a":61,"t":"عَلَىٰ أَنْ نُبَدِّلَ أَمْثَالَكُمْ وَنُنْشِئَكُمْ فِي مَا لَا تَعْلَمُونَ"},{"s":56,"a":62,"t":"وَلَقَدْ عَلِمْتُمُ النَّشْأَةَ الْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ"},{"s":56,"a":63,"t":"أَفَرَأَيْتُمْ مَا تَحْرُثُونَ"},{"s":56,"a":64,"t":"أَأَنْتُمْ تَزْرَعُونَهُ أَمْ نَحْنُ الزَّارِعُونَ"},{"s":56,"a":65,"t":"لَوْ نَشَاءُ لَجَعَلْنَاهُ حُطَامًا فَظَلْتُمْ تَفَكَّهُونَ"},{"s":56,"a":66,"t":"إِنَّا لَمُغْرَمُونَ"},{"s":56,"a":67,"t":"بَلْ نَحْنُ مَحْرُومُونَ"},{"s":56,"a":68,"t":"أَفَرَأَيْتُمُ الْمَاءَ الَّذِي تَشْرَبُونَ"},{"s":56,"a":69,"t":"أَأَنْتُمْ أَنْزَلْتُمُوهُ مِنَ الْمُزْنِ أَمْ نَحْنُ الْمُنْزِلُونَ"},{"s":56,"a":70,"t":"لَوْ نَشَاءُ جَعَلْنَاهُ أُجَاجًا فَلَوْلَا تَشْكُرُونَ"},{"s":56,"a":71,"t":"أَفَرَأَيْتُمُ النَّارَ الَّتِي تُورُونَ"},{"s":56,"a":72,"t":"أَأَنْتُمْ أَنْشَأْتُمْ شَجَرَتَهَا أَمْ نَحْنُ الْمُنْشِئُونَ"},{"s":56,"a":73,"t":"نَحْنُ جَعَلْنَاهَا تَذْكِرَةً وَمَتَاعًا لِلْمُقْوِينَ"},{"s":56,"a":74,"t":"فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظِيمِ"},{"s":56,"a":75,"t":"۞ فَلَا أُقْسِمُ بِمَوَاقِعِ النُّجُومِ"},{"s":56,"a":76,"t":"وَإِنَّهُ لَقَسَمٌ لَوْ تَعْلَمُونَ عَظِيمٌ"}]