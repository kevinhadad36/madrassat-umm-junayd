[{"s":37,"a":154,"t":"مَا لَكُمْ كَيْفَ تَحْكُمُونَ"},{"s":37,"a":155,"t":"أَفَلَا تَذَكَّرُونَ"},{"s":37,"a":156,"t":"أَمْ لَكُمْ سُلْطَانٌ مُبِينٌ"},{"s":37,"a":157,"t":"فَأْتُوا بِكِتَابِكُمْ إِنْ كُنْتُمْ صَادِقِينَ"},{"s":37,"a":158,"t":"وَجَعَلُوا بَيْنَهُ وَبَيْنَ الْجِنَّةِ نَسَبًا ۚ وَلَقَدْ عَلِمَتِ الْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَ"},{"s":37,"a":159,"t":"سُبْحَانَ اللَّهِ عَمَّا يَصِفُونَ"},{"s":37,"a":160,"t":"إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ"},{"s":37,"a":161,"t":"فَإِنَّكُمْ وَمَا تَعْبُدُونَ"},{"s":37,"a":162,"t":"مَا أَنْتُمْ عَلَيْهِ بِفَاتِنِينَ"},{"s":37,"a":163,"t":"إِلَّا مَنْ هُوَ صَالِ الْجَحِيمِ"},{"s":37,"a":164,"t":"وَمَا مِنَّا إِلَّا لَهُ مَقَامٌ مَعْلُومٌ"},{"s":37,"a":165,"t":"وَإِنَّا لَنَحْنُ الصَّافُّونَ"},{"s":37,"a":166,"t":"وَإِنَّا لَنَحْنُ الْمُسَبِّحُونَ"},{"s":37,"a":167,"t":"وَإِنْ كَانُوا لَيَقُولُونَ"},{"s":37,"a":168,"t":"لَوْ أَنَّ عِنْدَنَا ذِكْرًا مِنَ الْأَوَّلِينَ"},{"s":37,"a":169,"t":"لَكُنَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ"},{"s":37,"a":170,"t":"فَكَفَرُوا بِهِ ۖ فَسَوْفَ يَعْلَمُونَ"},{"s":37,"a":171,"t":"وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا الْمُرْسَلِينَ"},{"s":37,"a":172,"t":"إِنَّهُمْ لَهُمُ الْمَنْصُورُونَ"},{"s":37,"a":173,"t":"وَإِنَّ جُنْدَنَا لَهُمُ الْغَالِبُونَ"},{"s":37,"a":174,"t":"فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ"},{"s":37,"a":175,"t":"وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَ"},{"s":37,"a":176,"t":"أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ"},{"s":37,"a":177,"t":"فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَاءَ صَبَاحُ الْمُنْذَرِينَ"},{"s":37,"a":178,"t":"وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ"},{"s":37,"a":179,"t":"وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ"},{"s":37,"a":180,"t":"سُبْحَانَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَّا يَصِفُونَ"},{"s":37,"a":181,"t":"وَسَلَامٌ عَلَى الْمُرْسَلِينَ"},{"s":37,"a":182,"t":"وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ"}]